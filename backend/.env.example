NODE_ENV=production
PORT=10000
FRONTEND_URL=https://seudominio.com,https://www.seudominio.com
APP_PUBLIC_URL=https://api.seudominio.com

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_do_supabase
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_do_supabase

GEMINI_API_KEY=sua_chave_gemini
JWT_SECRET=opcional_para_integracoes_futuras

# Use true somente em instalacoes locais/controladas.
AUTH_AUTO_CONFIRM_EMAIL=false

# Mantem usuarios impedidos de virar Pro pela propria API.
# Ative apenas se voce implementar licenca ou controle local confiavel.
ALLOW_SELF_MANAGED_SUBSCRIPTIONS=false

# Mercado Pago
MERCADO_PAGO_PUBLIC_KEY=sua_public_key_mercado_pago
MERCADO_PAGO_ACCESS_TOKEN=seu_access_token_mercado_pago
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_USE_SANDBOX=false
# Obrigatorio em producao. Sem este segredo, o webhook Mercado Pago retorna 503 e nao processa pagamentos.
MERCADO_PAGO_WEBHOOK_SECRET=seu_secret_do_webhook
MERCADO_PAGO_NOTIFICATION_URL=https://api.seudominio.com/api/webhooks/mercado-pago

# EFI Bank
# Novo gateway principal do checkout. Credenciais ficam somente no backend.
EFI_CLIENT_ID=seu_client_id_efi
EFI_CLIENT_SECRET=seu_client_secret_efi
EFI_ENVIRONMENT=sandbox
EFI_SANDBOX=true
EFI_PIX_KEY=sua_chave_pix_efi
# Use um dos dois formatos de certificado:
EFI_CERT_PATH=./certs/efi.p12
EFI_CERT_BASE64=
EFI_CERT_PASSPHRASE=
EFI_WEBHOOK_SECRET=seu_token_compartilhado_webhook_efi
EFI_WEBHOOK_URL=https://api.seudominio.com/api/webhooks/efi

# Asaas
# Legado/fallback tecnico. Desativado por padrao; use true somente se for operar Asaas de forma controlada.
ENABLE_ASAAS=false
ASAAS_API_KEY=sua_api_key_asaas
ASAAS_BASE_URL=https://api.asaas.com/v3
# Obrigatorio em producao. Deve ser igual ao token configurado no webhook do Asaas.
ASAAS_WEBHOOK_TOKEN=seu_token_webhook_asaas
ASAAS_ENVIRONMENT=production
ASAAS_WALLET_ID=
