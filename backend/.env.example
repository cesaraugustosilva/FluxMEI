NODE_ENV=production
PORT=10000
FRONTEND_URL=https://seudominio.com,https://www.seudominio.com
APP_PUBLIC_URL=https://api.seudominio.com

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_do_supabase
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_do_supabase
# Opcional, apenas se voce implementar validacao local de JWT Supabase no futuro.
# O middleware atual NAO usa esta variavel; ele valida com supabaseAdmin.auth.getUser(token).
SUPABASE_JWT_SECRET=

GEMINI_API_KEY=sua_chave_gemini
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini
# Opcional, reservado para tokens proprios do FluxMEI se existirem no futuro.
# Nao use para validar tokens do Supabase Auth.
JWT_SECRET=opcional_para_integracoes_futuras

# Use true somente em instalacoes locais/controladas.
AUTH_AUTO_CONFIRM_EMAIL=false

# Mantem usuarios impedidos de virar Pro pela propria API.
# Ative apenas se voce implementar licenca ou controle local confiavel.
ALLOW_SELF_MANAGED_SUBSCRIPTIONS=false

# Administradores do painel /admin.
# Separe multiplos e-mails por virgula. Alternativamente, marque profiles.is_admin=true no Supabase.
ADMIN_EMAILS=admin@seudominio.com

# Gateway principal. Use `asaas` para producao atual; mantenha `efi` apenas como fallback tecnico.
PAYMENT_GATEWAY=asaas

# Asaas
# Credenciais ficam somente no backend.
# Cartao Asaas nao exige variavel publica no frontend; nunca exponha ASAAS_API_KEY.
ASAAS_API_KEY=sua_api_key_asaas
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=seu_token_webhook_asaas
ASAAS_WEBHOOK_URL=https://fluxmei.onrender.com/api/webhooks/asaas

# E-mails automaticos
# Preferencialmente use Resend. Nunca exponha RESEND_API_KEY no frontend.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=FluxMEI <no-reply@seudominio.com>

# Efí Bank fallback tecnico.
# Credenciais ficam somente no backend.
EFI_CLIENT_ID=seu_client_id_efi
EFI_CLIENT_SECRET=seu_client_secret_efi
EFI_ENVIRONMENT=sandbox
EFI_SANDBOX=true
EFI_PIX_KEY=sua_chave_pix_efi

# Use um dos dois formatos de certificado:
EFI_CERT_PATH=./certs/efi.p12
EFI_CERT_BASE64=
EFI_CERT_PASSPHRASE=

EFI_WEBHOOK_SECRET=seu_token_compartilhado_webhook_efi
EFI_WEBHOOK_URL=https://fluxmei.onrender.com/api/webhooks/efi

# Frontend build / Vercel. Valores publicos.
FLUXMEI_PAYMENT_GATEWAY=asaas
