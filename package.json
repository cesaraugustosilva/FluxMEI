{
  "name": "fluxmei-desktop",
  "version": "1.0.0",
  "description": "FluxMEI desktop para Windows.",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "FluxMEI",
  "license": "UNLICENSED",
  "scripts": {
    "desktop": "electron .",
    "build:win": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis",
    "pack:win": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win --dir"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.106.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.com.fluxmei.desktop",
    "productName": "FluxMEI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app.js",
      "index.html",
      "style.css",
      "auth/**/*",
      "backend/src/**/*",
      "backend/database/schema.sql",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/.env.example",
        "to": "fluxmei.env.example"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FluxMEI"
    }
  }
}
